@import url("fonts.css");

/* Define primary site colors */
:root {
  --primary: #0db629;
  --primary-black: color-mix(in srgb, var(--primary) 25%, black);
  --primary-dark: color-mix(in srgb, var(--primary) 50%, black);
  --primary-light: color-mix(in srgb, var(--primary) 30%, white);
  --secondary: #88a;
  --secondary-dark: color-mix(in srgb, var(--secondary) 80%, black);
  --secondary-light: color-mix(in srgb, var(--secondary) 80%, white);
  --background: #FEFDFA;
  --text: #111827;
  --text-medium: color-mix(in srgb, var(--text) 80%, white);
  --text-light: color-mix(in srgb, var(--text) 50%, white);
}

:root {
  --margin-right: 38vw;
  --margin-left: 22vw;
}

html {
  /* scroll-padding-top: 5rem; */
  background-color: var(--background);
}

body {
  margin: 0 var(--margin-right) 1rem var(--margin-left);
  width: auto;
  font-family: 'Libertinus Serif';
  font-size: 1.2rem;
  background-color: var(--background);
  color: var(--text);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

body a {
  color: var(--primary-black);
  text-decoration: underline;
}
body a:hover {
  color: var(--primary);
}


nav.top-nav-bar {
  position: sticky;
  top: 0;
  background: var(--primary-light);
  margin: 0 calc(-1 * var(--margin-right)) 0 calc(-1 * var(--margin-left));
  padding: 5px var(--margin-right) 5px var(--margin-left);
  font-family: 'Libertinus Serif';
}

nav.top-nav-bar ul {
  display: flex;
  align-items: center;
  gap: 1rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

nav.top-nav-bar a,
nav.top-nav-bar a:visited {
  color: var(--text);
  text-decoration: none;
}
nav.top-nav-bar a:hover {
  color: var(--primary);
  text-decoration: underline;
}

nav.top-nav-bar * {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  line-height: 1em;
  margin: 0;
}
/* 
main {
  padding-top: 0.5rem;
} */

img {
  max-width: 100%;
}

h1, h2, h3, h4, h5, h6 {
  margin-bottom: 1em;
  font-family: 'Libertinus Sans';
}
p, li {
  line-height: 1.4;
}
li {
  margin-bottom: 0.5em;
}
p {
  margin-bottom: 0.9em;
}
li p {
  margin: 0;
}
pre, code {
  font-size: 1rem;
}

figcaption {
  font-size: 1.1rem;
  color: #444;
}

span.small-text {
  font-size: 1.1rem;
}

div.centered-frame {
  margin: 0.5em 0;
}

div.article-link {
  font-family: 'Libertinus Serif';
}

div.article-link a {
  text-decoration: none;
  color: var(--text);
}

div.article-link a:hover {
  text-decoration: underline;
  color: var(--primary);
}

.article-subtitle {
  color: var(--text-medium);
}

.article-date {
  color: var(--text-light);
}

.article-title .article-date {
  font-style: italic;
}

footer {
  text-align: center;
  margin-top: auto;
  padding: 6rem 0 1rem 0;
  font-size: 0.95rem;
  color: var(--text-light);
  /* border-top: 1px solid #F00; */
}
footer a {
  color: var(--text-light);
  text-decoration: underline;
}
footer a:hover {
  color: var(--text);
  text-decoration: underline;
}

/* For narrower screens */
@media (max-width: 1500px) {
  body {
    margin-left: 15vw;
    margin-right: 25vw;
  }
}

/* For phone screens */
@media (max-width: 1000px) {
  body {
    margin: 0 1.5rem;
  }
}